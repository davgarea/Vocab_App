<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps all of its data (courses, progress, settings) in the web
     view's local storage. Android's cloud backup / device transfer used to put
     that back after an uninstall + reinstall, so a "fresh" install came back
     with old courses and no tutorial. Nothing is backed up now. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
